---
import { quizzes } from '../data/quizzes';
import { tex } from '../lib/tex';

interface Props { quizId: string }
const { quizId } = Astro.props;
const set = quizzes[quizId];

const payload = set ? {
  id: set.id,
  title: set.title,
  questions: set.questions.map((q, i) => ({
    stem: tex(q.stem),
    options: q.options.map(tex),
    answer: q.answer,
    explain: tex(q.explain),
    ref: `${set.id}#${i}`,
    difficulty: q.difficulty ?? 'basic',
  })),
} : null;
---
{set && payload && (
<section class="quiz" id="quiz" aria-label={`随堂练习：${set.title}`}>
  <div class="quiz-head">
    <h2>随堂练习 · {set.title}</h2>
    <span>选完立即判分，做完算一次练习记录</span>
  </div>
  <div class="quiz-body-root" data-quiz-root>
    <div class="quiz-dots" data-quiz-dots aria-hidden="true"></div>
    <div data-quiz-body></div>
    <div class="quiz-actions">
      <button type="button" class="button primary" data-quiz-next hidden>下一题 →</button>
    </div>
  </div>
  <script type="application/json" data-quiz-payload set:html={JSON.stringify(payload).replace(/</g, '\\u003c')} />
</section>
)}

<script>
import { mountQuiz } from '../lib/quiz-engine';
import { recordQuizAttempt } from '../lib/progress';

const root = document.querySelector<HTMLElement>('[data-quiz-root]');
const payloadEl = document.querySelector<HTMLScriptElement>('[data-quiz-payload]');
if (root && payloadEl) {
  try {
    const payload = JSON.parse(payloadEl.textContent || 'null');
    if (payload?.questions?.length) {
      mountQuiz(root, payload, (score, _total, results) => {
        const saved = recordQuizAttempt(payload.id, score, results);
        const wrongCount = results.filter((r) => !r.correct && r.ref).length;
        const note = document.querySelector<HTMLElement>('[data-quiz-storage-note]');
        if (note) note.textContent = saved
          ? `最佳成绩 ${saved.quiz[payload.id]?.best ?? score} / ${payload.questions.length}${wrongCount ? ` · ${wrongCount} 道错题已进错题本，明天来复习` : ''}`
          : '进度未能保存，刷新后可能丢失。';
      });
    }
  } catch { /* 题库数据异常时不渲染交互，不影响正文 */ }
}
</script>
