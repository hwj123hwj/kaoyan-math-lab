---
// 中值定理实验室：连接 (a,f(a)) 与 (b,f(b)) 的弦，拖动 ξ 找切线平行于弦的点。
---
<section class="lab" id="lab-mvt" aria-label="中值定理实验室">
  <div class="lab-toolbar">
    <label>函数与区间 <select id="mv-f">
      <option value="cubic" selected>x³−3x · [−2, 2]（弦斜率 0）</option>
      <option value="quad">x² · [0, 2]</option>
      <option value="log">ln x · [1, 3]</option>
      <option value="sin">sin x · [0, π]</option>
    </select></label>
    <label>ξ = <output id="mv-xi-out">0.0</output> <input id="mv-xi" type="range" min="-2" max="2" step="0.01" value="0"></label>
    <button id="mv-find" class="button" type="button">帮我找到那个点</button>
    <button id="mv-reset" class="text-button" type="button">重置</button>
  </div>
  <canvas id="mv-canvas" class="lab-canvas" height="380" aria-label="弦与切线"></canvas>
  <div class="lab-readouts">
    <div><span>弦的斜率</span><code id="mv-chord">—</code><small>[f(b) − f(a)] / (b − a)</small></div>
    <div><span>ξ 处切线斜率</span><code id="mv-tangent">—</code><small>f′(ξ)</small></div>
    <div><span>差值</span><code id="mv-gap">—</code><small>为 0 时定理成立</small></div>
  </div>
  <p class="lab-message" id="mv-message" role="status">拉格朗日中值定理说：这样的 ξ 一定存在。拖动滑块自己找，或点按钮让程序扫出来。</p>
</section>

<script>
import { fitCanvas, makeScale, drawAxes, plotFunction, reducedMotion } from '../../lib/plot';

interface Cfg {
  f: (x: number) => number;
  d: (x: number) => number;
  a: number; b: number;
  xiMin: number; xiMax: number;
  box: { xmin: number; xmax: number; ymin: number; ymax: number };
  label: string;
}
const cfgs: Record<string, Cfg> = {
  cubic: { f: (x) => x ** 3 - 3 * x, d: (x) => 3 * x * x - 3, a: -2, b: 2, xiMin: -2, xiMax: 2, box: { xmin: -2.6, xmax: 2.6, ymin: -5, ymax: 5 }, label: 'f(x) = x³ − 3x：f(−2)=f(2)=−2，弦是水平的——这就是罗尔定理' },
  quad: { f: (x) => x * x, d: (x) => 2 * x, a: 0, b: 2, xiMin: 0, xiMax: 2, box: { xmin: -0.4, xmax: 2.6, ymin: -0.8, ymax: 4.6 }, label: 'f(x) = x²：弦斜率 2，ξ = 1 时切线恰好平行' },
  log: { f: Math.log, d: (x) => 1 / x, a: 1, b: 3, xiMin: 1, xiMax: 3, box: { xmin: 0.4, xmax: 3.5, ymin: -1.2, ymax: 1.6 }, label: 'f(x) = ln x：f(3)−f(1) = ln 3，弦斜率 ln3/2，ξ = 2/ln3 ≈ 1.82' },
  sin: { f: Math.sin, d: Math.cos, a: 0, b: Math.PI, xiMin: 0, xiMax: Math.PI, box: { xmin: -0.4, xmax: 3.5, ymin: -1.4, ymax: 1.6 }, label: 'f(x) = sin x：弦水平（都为 0），ξ = π/2 处切线水平' },
};

const canvas = document.getElementById('mv-canvas') as HTMLCanvasElement;
const xiInput = document.getElementById('mv-xi') as HTMLInputElement;
const fSel = document.getElementById('mv-f') as HTMLSelectElement;
const findBtn = document.getElementById('mv-find') as HTMLButtonElement;
const message = document.getElementById('mv-message')!;
let timer: ReturnType<typeof setInterval> | null = null;
function stop() { if (timer !== null) { clearInterval(timer); timer = null; } }

function draw() {
  const fit = fitCanvas(canvas); if (!fit) return;
  const { ctx, w, h } = fit;
  const cfg = cfgs[fSel.value];
  xiInput.min = String(cfg.xiMin);
  xiInput.max = String(cfg.xiMax);
  const s = makeScale(cfg.box, w, h, 8);
  drawAxes(ctx, s, cfg.box, 1, 1);

  const xi = Number(xiInput.value);
  document.getElementById('mv-xi-out')!.textContent = xi.toFixed(2);

  ctx.font = '12px ui-monospace, monospace';
  ctx.fillStyle = 'rgba(80,80,110,.65)';
  ctx.textAlign = 'left';
  ctx.fillText(cfg.label, 12, h - 10);

  const ya = cfg.f(cfg.a), yb = cfg.f(cfg.b);
  const chord = (yb - ya) / (cfg.b - cfg.a);
  const slope = cfg.d(xi);

  // 弦（灰虚线）
  ctx.setLineDash([7, 5]);
  ctx.strokeStyle = 'rgba(90,90,110,.75)';
  ctx.lineWidth = 1.6;
  line(ctx, s, cfg.a, ya, cfg.b, yb);
  // ξ 处切线
  ctx.strokeStyle = 'rgba(230,120,40,.95)';
  ctx.lineWidth = 1.8;
  const pad = (cfg.box.xmax - cfg.box.xmin) * 0.45;
  line(ctx, s, xi - pad, cfg.f(xi) - slope * pad, xi + pad, cfg.f(xi) + slope * pad);
  ctx.setLineDash([]);

  // 端点与 ξ 点
  dot(ctx, s, cfg.a, ya, 'rgba(90,90,110,.9)');
  dot(ctx, s, cfg.b, yb, 'rgba(90,90,110,.9)');
  const parallel = Math.abs(slope - chord) < 0.04;
  dot(ctx, s, xi, cfg.f(xi), parallel ? '#1f9d6b' : '#3b3f8f', 6);

  document.getElementById('mv-chord')!.textContent = chord.toFixed(4);
  document.getElementById('mv-tangent')!.textContent = slope.toFixed(4);
  const gap = slope - chord;
  document.getElementById('mv-gap')!.textContent = Math.abs(gap) < 5e-3 ? '≈ 0 · 平行！' : gap.toFixed(3);

  if (parallel) {
    message.textContent = `ξ = ${xi.toFixed(2)}：切线（橙）与弦（灰虚线）平行，f′(ξ) = 弦斜率。定理说得没错——总有一个这样的点存在。`;
  } else {
    message.textContent = `ξ = ${xi.toFixed(2)}：还没对齐。斜率差 ${gap.toFixed(3)}，继续拖，或点“帮我找到那个点”。`;
  }
}

function line(ctx: CanvasRenderingContext2D, s: ReturnType<typeof makeScale>, xa: number, ya: number, xb: number, yb: number) {
  ctx.beginPath(); ctx.moveTo(s.x2px(xa), s.y2px(ya)); ctx.lineTo(s.x2px(xb), s.y2px(yb)); ctx.stroke();
}
function dot(ctx: CanvasRenderingContext2D, s: ReturnType<typeof makeScale>, x: number, y: number, color: string, r = 5) {
  ctx.beginPath(); ctx.arc(s.x2px(x), s.y2px(y), r, 0, Math.PI * 2);
  ctx.fillStyle = color; ctx.fill();
  ctx.strokeStyle = '#fff'; ctx.lineWidth = 1.5; ctx.stroke();
}

findBtn.addEventListener('click', () => {
  stop();
  const cfg = cfgs[fSel.value];
  // 数值扫描：直接在滑块的两位小数网格上找 |f'(x) − 弦斜率| 最小的位置
  const chord = (cfg.f(cfg.b) - cfg.f(cfg.a)) / (cfg.b - cfg.a);
  let bestX = cfg.xiMin, bestVal = Infinity;
  const lo = Math.ceil(cfg.xiMin * 100) / 100, hi = Math.floor(cfg.xiMax * 100) / 100;
  for (let x = lo; x <= hi + 1e-9; x += 0.01) {
    const v = Math.abs(cfg.d(x) - chord);
    if (v < bestVal) { bestVal = v; bestX = x; }
  }
  if (reducedMotion()) { xiInput.value = bestX.toFixed(2); draw(); return; }
  const from = Number(xiInput.value);
  let t = 0;
  timer = setInterval(() => {
    t += 0.04;
    const e = Math.min(1, t);
    const eased = 1 - Math.pow(1 - e, 3);
    xiInput.value = (from + (bestX - from) * eased).toFixed(2);
    draw();
    if (e >= 1) stop();
  }, 25);
});

for (const el of [xiInput, fSel]) el.addEventListener('input', () => { stop(); draw(); });
document.getElementById('mv-reset')!.addEventListener('click', () => {
  stop(); fSel.value = 'cubic'; xiInput.value = '-2'; draw();
});
window.addEventListener('resize', draw);
draw();
</script>
